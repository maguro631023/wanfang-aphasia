{
  "_說明": [
    "這個檔案控制畫面上「顯示哪些項目」和「排列順序」，改完直接 commit 即可，不必動 index.html。",
    "陣列由上到下就是畫面由左到右、由上到下的順序，調整順序＝搬動整個區塊的位置。",
    "enabled 設成 false 會隱藏該項目，但設定保留著，日後改回 true 就會出現。",
    "沒有列在這裡的項目會排在最後面，所以新增詞條時不一定要同步改這個檔。",
    "檔案若刪除或格式寫錯，程式會自動退回內建的預設順序，不會壞掉。"
  ],

  "cart": {
    "enabled": true,
    "max": 5,
    "categories": ["daily", "food", "people", "act", "body"],
    "single": ["act"],
    "scale": ["body"],
    "sentence": true,
    "_說明": "enabled 關閉整個購物清單功能；max 是單項最大數量；categories 列出哪些類別的項目可以加入清單。身體不適（body）與我想要（act）預設不開放，因為頭痛、上廁所這類詞沒有數量的概念；需要的話把 body、act 加進來即可。single 列出「只能是 1」的類別：這些項目可以加入清單，但不顯示增減按鈕，唸出時也不帶數量與量詞。scale 列出用「強度 1～5」而非數量的類別，清單裡以量表方式呈現，唸出時改用「有一點／很／非常」等程度副詞。sentence 為 true 時，清單會組成一句完整的話（我要…。我想要…。我覺得…。）並顯示在畫面上；設成 false 則改回逐筆唸出。"
  },

  "categories": [
    { "id": "daily",  "enabled": true,  "_": "日常用品" },
    { "id": "food",   "enabled": true,  "_": "食物飲料" },
    { "id": "body",   "enabled": true,  "_": "身體不適" },
    { "id": "people", "enabled": true,  "_": "家人醫護" },
    { "id": "act",    "enabled": true,  "_": "我想要" }
  ],

  "words": [
    { "id": "toothbrush", "enabled": true, "_": "牙刷" },
    { "id": "glasses",    "enabled": true, "_": "眼鏡" },
    { "id": "towel",      "enabled": true, "_": "毛巾" },
    { "id": "television", "enabled": true, "_": "電視" },

    { "id": "water",    "enabled": true, "_": "水" },
    { "id": "rice",     "enabled": true, "_": "飯" },
    { "id": "noodles",  "enabled": true, "_": "麵" },
    { "id": "medicine", "enabled": true, "_": "藥" },

    { "id": "headache", "enabled": true, "_": "頭痛" },
    { "id": "sleepy",   "enabled": true, "_": "想睡" },
    { "id": "thirsty",  "enabled": true, "_": "口渴" },
    { "id": "cold",     "enabled": true, "_": "會冷" },

    { "id": "wife",     "enabled": true, "_": "太太" },
    { "id": "son",      "enabled": true, "_": "兒子" },
